{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "resources.schema.json",
  "title": "Resources Schema",
  "description": "Schema for resources.json - defines game resources",
  "type": "object",
  "required": ["resources"],
  "properties": {
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "tier"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "tier": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "stackSize": { "type": "integer", "minimum": 1 },
          "baseValue": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
