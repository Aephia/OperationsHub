{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "shipComponents.schema.json",
  "title": "Ship Components Schema",
  "description": "Schema for ship-components manifest and parts - defines component hierarchies",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "timestamp": { "type": "string" },
    "parts": {
      "type": "array",
      "items": { "type": "string" }
    },
    "components": {
      "type": "object",
      "properties": {
        "nextId": { "type": "integer", "minimum": 0 },
        "allComponents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "properties": {
              "id": { "type": "integer" },
              "name": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "properties": {
                "type": "object",
                "patternProperties": {
                  "^.*$": { "type": "string" }
                }
              },
              "propertyOrder": {
                "type": "array",
                "items": { "type": "string" }
              },
              "children": {
                "type": "array"
              },
              "expanded": { "type": "boolean" },
              "status": { "type": "string" },
              "nameSource": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
