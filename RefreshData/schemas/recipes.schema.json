{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "recipes.schema.json",
  "title": "Recipes Schema",
  "description": "Schema for recipes.json - defines crafting recipes",
  "type": "object",
  "required": ["recipes"],
  "properties": {
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["outputId", "outputName", "outputType", "outputTier"],
        "properties": {
          "outputId": { "type": "string" },
          "outputName": { "type": "string" },
          "outputType": { "type": "string" },
          "outputTier": { "type": "integer", "minimum": 1 },
          "buildingResourceTier": { "type": "integer", "minimum": 1 },
          "constructionTime": { "type": "integer", "minimum": 0 },
          "planetTypes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "factions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "resourceType": { "type": "string" },
          "productionSteps": { "type": "integer", "minimum": 1 },
          "ingredients": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "quantity"],
              "properties": {
                "name": { "type": "string" },
                "quantity": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
